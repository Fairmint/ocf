{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://opencaptablecoalition.com/extensions-registry/registry.schema.json",
  "title": "OCF extension registry index",
  "description": "Machine-readable index of coalition profiles (ocf.*) and vendor extensions (com.*). See OCIP-0001.",
  "type": "object",
  "required": ["version", "profiles"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Registry format version (semver), not an OCF or profile version.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/definitions/profileRow" }
    }
  },
  "definitions": {
    "profileId": {
      "type": "string",
      "pattern": "^(ocf(\\.[a-z0-9]+(-[a-z0-9]+)*)+|com\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+)$"
    },
    "semverVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "semverRange": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9><=\\s.\\-*]+$"
    },
    "repoRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"
    },
    "profileRow": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status",
        "schema",
        "requires_ocf",
        "min_ocf_version",
        "requires_profiles",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/profileId" },
        "version": { "$ref": "#/definitions/semverVersion" },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "accepted",
            "deprecated",
            "superseded",
            "rejected",
            "vendor"
          ]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "schema": { "$ref": "#/definitions/repoRelativePath" },
        "spec": { "$ref": "#/definitions/repoRelativePath" },
        "requires_ocf": { "$ref": "#/definitions/semverRange" },
        "min_ocf_version": { "$ref": "#/definitions/semverVersion" },
        "requires_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "version"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/definitions/profileId" },
              "version": { "$ref": "#/definitions/semverRange" }
            }
          }
        },
        "owner": {
          "type": "string",
          "description": "coalition or vendor organization name."
        },
        "created": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "superseded_by": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["id", "version"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/definitions/profileId" },
                "version": { "$ref": "#/definitions/semverVersion" }
              }
            },
            {
              "type": "object",
              "required": ["ocf", "version"],
              "additionalProperties": false,
              "properties": {
                "ocf": { "const": true },
                "version": { "$ref": "#/definitions/semverVersion" }
              }
            }
          ]
        }
      }
    }
  }
}